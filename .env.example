# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=miamdv
MYSQL_USER=miammi
MYSQL_PASSWORD=change_me

# --- Backend (NestJS) ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me
# Comma-separated allowed origins (ex: https://app.tld,https://admin.tld)
CORS_ORIGIN=https://miamdv.diogo-andrade.org
DB_SYNC=false

# --- Reverse-proxy network (external) ---
# This network must exist before `docker compose up`:
# docker network create caddy_net
PROXY_NETWORK=caddy_net
FRONTEND_PORT=4000

# --- MCP (NestJS guard + MCP server) ---
MCP_API_KEY=change_me
MCP_API_KEY_SCOPES=mcp:menu:write,mcp:menu:delete,mcp:proverb:write,mcp:proverb:delete,mcp:week:clear,mcp:week:read
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=60

# --- MCP server (HTTP) ---
MCP_HTTP_PORT=4310
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,miamdv.diogo-andrade.org,caddy
MCP_ALLOWED_ORIGINS=https://miamdv.diogo-andrade.org
